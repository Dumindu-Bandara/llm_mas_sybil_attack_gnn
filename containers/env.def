Bootstrap: docker

From: nvidia/cuda:13.0.1-devel-ubuntu24.04

%files
    pyproject.toml /opt/build/pyproject.toml
    uv.lock        /opt/build/uv.lock

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    # --- System packages -----------------------------------------------------
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential ninja-build git curl ca-certificates \
        jq ripgrep less vim-tiny htop \
        libgl1 libglib2.0-0
    rm -rf /var/lib/apt/lists/*

    # --- uv ------------------------------------------------------------------
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin INSTALLER_NO_MODIFY_PATH=1 sh

    # --- Python + dependencies (exact versions from uv.lock) -----------------
    export UV_PYTHON_INSTALL_DIR=/opt/uv-python   # uv-managed Python, readable by all users
    export UV_PROJECT_ENVIRONMENT=/opt/venv
    export UV_LINK_MODE=copy                      # no hardlinks into a build-time cache
    export UV_COMPILE_BYTECODE=1                  # faster imports at run time
    export UV_CACHE_DIR=/tmp/uv-cache

    PY=3.12                                       # keep in sync with requires-python
    cd /opt/build
    uv python install "$PY"
    uv sync --frozen --no-install-project --python "$PY"
    rm -rf /tmp/uv-cache

    # --- Claude Code (optional) ---------------------------------------------
    CLAUDE_TMP=/tmp/claude-install
    curl -fsSL https://claude.ai/install.sh | HOME=$CLAUDE_TMP bash
    install -m 755 "$(readlink -f $CLAUDE_TMP/.local/bin/claude)" /usr/local/bin/claude
    rm -rf "$CLAUDE_TMP"

    # Make everything readable/executable for the non-root user at run time
    chmod -R a+rX /opt

%environment
    export PATH=/opt/venv/bin:/usr/local/cuda/bin:/usr/local/bin:$PATH
    export VIRTUAL_ENV=/opt/venv
    export CUDA_HOME=/usr/local/cuda

    # Compile custom CUDA extensions for both GPU types: L4 = 8.9, B200 = 10.0
    export TORCH_CUDA_ARCH_LIST="8.9;10.0"

    export PYTHONNOUSERSITE=1          # ignore host ~/.local packages
    export PYTHONUNBUFFERED=1          # real-time logs in batch jobs
    export DISABLE_AUTOUPDATER=1       # Claude Code: SIF is read-only, update by rebuilding

    # Caches: point these at scratch from your job script if $HOME quota is small, e.g.
    #   export HF_HOME=/scratch/$USER/hf  TRITON_CACHE_DIR=/scratch/$USER/triton

%runscript
    exec python "$@"

%test
    # Runs at the end of the build (no GPU needed): checks the install, prints compiled GPU archs
    /opt/venv/bin/python - <<'EOF'
import torch
print("torch", torch.__version__, "| CUDA", torch.version.cuda, "| cuDNN", torch.backends.cudnn.version())
print("compiled archs:", torch.cuda.get_arch_list())
EOF

%labels
    Description PyTorch (CUDA 13.0) research env for B200 + L4
    Version 2026-11-20

%help
    Research environment container.
    Run with --nv. Dependencies are in /opt/venv (read-only); project code is bind-mounted at run time.
    Verify the GPU:  apptainer exec --nv <image>.sif python -c "import torch; print(torch.cuda.get_device_name())"
